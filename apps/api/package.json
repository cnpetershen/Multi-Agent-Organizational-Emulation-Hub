{
  "name": "@maoeh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@maoeh/shared-types": "workspace:*"
    ,"@maoeh/organization-control": "workspace:*"
    ,"@maoeh/agent-definition": "workspace:*"
    ,"@maoeh/agent-cognition": "workspace:*"
    ,"@maoeh/llm-gateway": "workspace:*"
    ,"@maoeh/kernel": "workspace:*"
    ,"@maoeh/organization-model": "workspace:*"
    ,"@maoeh/permission-system": "workspace:*"
    ,"@maoeh/workflow-engine": "workspace:*"
    ,"@maoeh/event-store": "workspace:*"
    ,"@maoeh/event-system": "workspace:*"
  }
}
