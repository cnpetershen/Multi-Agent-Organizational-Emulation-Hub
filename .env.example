# MAOEH LLM configuration — copy to `.env` and fill in. `.env` is git-ignored.
#
# Load it without adding a dependency:
#   pnpm dev                                    (the api dev script passes --env-file-if-exists)
#   node --env-file=.env apps/api/dist/index.js  (explicit entrypoint)
#
# The default is `mock`: a deterministic in-process provider that answers with the same JSON
# contract a live model would return. CI and the simulation suite rely on it, so leaving every
# variable below unset is the supported configuration and changes nothing.

# ---------------------------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------------------------
# mock | live.  Default: mock.
# In `live` mode a missing key is an error, never a silent fall back to the mock, and the run is
# refused while CI is set.
MAOEH_LLM_MODE=mock

# ---------------------------------------------------------------------------------------------
# Live provider — DeepSeek speaks the OpenAI chat-completions protocol
# ---------------------------------------------------------------------------------------------
# Absolute http(s) URL. Default: https://api.deepseek.com
MAOEH_LLM_BASE_URL=https://api.deepseek.com

# Default: deepseek-flash (DeepSeek-V4.1-Flash). `deepseek-v4-pro` is the heavier alternative.
MAOEH_LLM_MODEL=deepseek-flash

# The secret itself. Required when MAOEH_LLM_MODE=live. Never commit this.
MAOEH_LLM_API_KEY=

# Logical provider id, reported in `llm_calls` and overridable per request. Default: deepseek
MAOEH_LLM_PROVIDER=deepseek

# ---------------------------------------------------------------------------------------------
# Model behaviour
# ---------------------------------------------------------------------------------------------
# enabled | disabled.  Default: disabled.
# DeepSeek turns thinking mode ON by default at effort `high`. In thinking mode `temperature`,
# `presence_penalty` and `frequency_penalty` are accepted but have NO effect, so leaving it
# enabled silently discards LlmRequest.temperature and multiplies the token cost of every turn.
# Enable it deliberately, per deployment, when reasoning depth matters more than cost.
MAOEH_LLM_THINKING=disabled

# Output ceiling. Default: 8192. DeepSeek caps output at 384000; keep this well below that so a
# truncated JSON plan cannot masquerade as a schema violation.
MAOEH_LLM_MAX_TOKENS=8192

# Per-attempt HTTP timeout in milliseconds. Default: 60000
MAOEH_LLM_TIMEOUT_MS=60000

# Total attempts per LLM call, including the first. Default: 1 (no retry).
# Each attempt consumes call budget and is recorded in `llm_calls` separately (ADR-008), so a
# retry never hides cost. Raise it above 1 to absorb DeepSeek's documented occasional empty
# `json_object` response. Max: 10.
MAOEH_LLM_MAX_ATTEMPTS=1

# ---------------------------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------------------------
# Set to true to permit `live` mode while CI is set. Default: false.
# CI must stay deterministic (docs/architecture/02-modules.md §2.5), so this is off by default.
MAOEH_LLM_ALLOW_LIVE_IN_CI=false
