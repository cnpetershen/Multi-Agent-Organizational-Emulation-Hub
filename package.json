    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
